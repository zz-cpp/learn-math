      for x0 in (0.2, 1.9, 3.6, 5.3) {
        line((x0, y), (x0 + 0.6, y), stroke: (paint: luma(155), thickness: 0.9pt), mark: (end: ">", fill: luma(155)))
      }
    }

    // ── 矩形闭曲线（逆时针绕行）──
    line((1.5, 1.0), (5.5, 1.0), (5.5, 4.0), (1.5, 4.0), close: true,
         stroke: (paint: rgb("#2f6fd0"), thickness: 1.6pt))

    // ── 四边的行进方向（橙，逆时针）──
    let oc = rgb("#d06a2f")
    line((2.0, 1.0), (3.0, 1.0), stroke: (paint: oc, thickness: 1.7pt), mark: (end: ">", fill: oc))
    line((5.5, 1.8), (5.5, 2.6), stroke: (paint: oc, thickness: 1.7pt), mark: (end: ">", fill: oc))
    line((5.0, 4.0), (4.0, 4.0), stroke: (paint: oc, thickness: 1.7pt), mark: (end: ">", fill: oc))
    line((1.5, 3.2), (1.5, 2.4), stroke: (paint: oc, thickness: 1.7pt), mark: (end: ">", fill: oc))

    // ── 两条竖直边的朝外法向（红）──
    let rc = rgb("#d64541")
    line((5.5, 3.45), (6.6, 3.45), stroke: (paint: rc, thickness: 1.7pt), mark: (end: ">", fill: rc))
    line((1.5, 1.55), (0.4, 1.55), stroke: (paint: rc, thickness: 1.7pt), mark: (end: ">", fill: rc))
    content((6.75, 3.45), $hat(n)$)
    content((0.25, 1.55), $hat(n)$, anchor: "east")

    // ── 四个边标签 ──
    content((3.4, 0.7), $C_1$)
    content((6.1, 2.25), $C_2$)
    content((3.4, 4.32), $C_3$)
    content((1.05, 2.25), $C_4$)

    // ── 两边的符号结论 ──
    content((6.75, 2.95), [$arrow(F) dot hat(n) > 0$（流出）], anchor: "west")
    content((0.25, 2.95), [$arrow(F) dot hat(n) < 0$（流入）], anchor: "east")
  }),
  caption: [
    *矩形闭曲线上两条竖直边的通量符号*（CeTZ 重绘，依据材料图 11）。
    场水平向右（浅灰箭头）；沿逆时针绕行、取行进方向的右手侧为 $hat(n)$：
    $C_2$ 的朝外法向朝*右*、与场同向 $arrow.r$ 流出 $arrow.r$ 通量为正；
    $C_4$ 的朝外法向朝*左*、与场反向 $arrow.r$ 流入 $arrow.r$ 通量为负；
    $C_1$、$C_3$ 的朝外法向与场垂直 $arrow.r$ 贡献为零。
  ],
)

== 关键点

约定回答的是“$hat(n)$ 取哪一侧”，通量回答的是“场在这个 $hat(n)$ 上投影多少”。*$C_4$ 并没有违反约定*：它的正方向确实是右手侧——只不过右手侧朝左，而场朝右，于是读数为负。凡是“逆时针绕行 $+$ 水平常向量场”，左右两边必定一正一负、总量为零。

== 变式检验

#enum(
  numbering: "1.",
  [*把场换成 $arrow(F) = (x, 0)$*（随 $x$ 增大）：$C_4$ 在左边 $x_L$ 处的场长为 $x_L$，$C_2$ 在右边 $x_R$ 处的场长为 $x_R$。若 $x_R > x_L$，则净通量 $= (x_R - x_L) H > 0$——这正是材料图 12“不再相消”的原因：*两侧场长不等，差就是净通量*。],
  [*改成顺时针绕行*：右手侧变成区域*内*的那一侧（内法向），$C_2$ 变负、$C_4$ 变正，总和仍为零。可见正负是“约定 $+$ 场”共同的结果，不是某条边的固有属性。],
  [*把场换成朝左* $arrow(F) = (-c, 0)$：$C_2$ 变负、$C_4$ 变正，依然完全抵消。],
)

== 同类归类

- 与 lec-11 例题 11（单位正方形、$arrow(F) = (x^2, y^2)$ 的分段验算）完全同款：那里算出的“右边 $+1$、上边 $+1$、左边 $0$、下边 $0$”，正是本问逐边表的另一个实例；
- 与“通量 ↔ 环量的对称性”（笔记材料 5、附录 T）配对：环量取*切向*分量，法向约定管的是“向哪边转”；通量取*法向*分量，法向约定管的是“取右手侧”——两套约定都来自同一个“旋转 $90$ 度”；
- 与格林公式的“正向”约定同源：逆时针（正向）$arrow.r$ 朝外法向，这也是考研里“补线后取正向”那句口诀的出处。

== 易错点

#warningbox[
  #enum(
    numbering: "1.",
    [*把“右侧”当成固定方位*（“右边就是东边”）。$C_4$ 上向下行进，右手侧是*左*——这里的“右”总是相对于*你的前进方向*而言。],
    [*把“逆时针 $arrow.r$ 朝外法向”读成“朝外法向 $arrow.r$ 通量为正”*。朝外只说明尺子摆向外侧；读数由场决定，可正、可负、可零。],
    [*以为 $C_1$、$C_3$ 的零贡献是“场没穿过它们”*。场一直在流动，只是沿这两条边*切向*流动，法向投影为零：$arrow(F) dot hat(n) = (c, 0) dot (0, -1) = 0$。],
    [*写 $hat(n)$ 时忘了它逐边变化*。同一条封闭曲线上，右边界 $hat(n) = (1, 0)$、左边界 $hat(n) = (-1, 0)$——$hat(n)$ 是逐点定义的，不是一条曲线一个。],
  )
]

= 🧪 问题 121：18.02.2x lec-09「扩展的格林定理」考研考不考？

读者问：检查笔记中的 Lecture: Extended Green's Theorem，考研是否也要考察这个内容。#footnote[来源：笔记 `~/note/2026/18.02.2x/lec-09/extended-greens-theorem.typ`（2102 行：材料 1–7 $+$ 配套 Recitation $+$ 附录 A–G，含材料原文照录与图 21 张）；考纲 = 考研数学一「多元函数积分学」考试内容与考试要求 8 条原文（中公考研《大纲原文解析》；学信网历年对比：该章多年“无变化”）。]

== 直接解答：*考，而且正是考纲里点名“会运用”“会求”的那两条*

#importantbox[
  lec-09 讲的其实只有两件正事：*“线积分什么时候与路径无关”* 与 *“怎么把这个原函数求出来”*。
  这两件事在同一份考纲里各自占一条明文：

  - *考试内容原文*：“……格林（Green）公式；*平面曲线积分与路径无关的条件*；*二元函数全微分的原函数*；……”
  - *考试要求第 5 条原文*：“*掌握格林公式并会运用平面曲线积分与路径无关的条件，会求二元函数全微分的原函数。*”

  所以这一讲不是“要不要看”的边角料——*它本身就是考纲第 5 条的正课*，而且是数学一最稳定的大题来源之一。
]

#knowledgebox[
  为什么它比 lec-11 更靠考纲中心：两讲都用同一份口径数过（核心知识点逐条标等级），

  #booktabs-table(
    columns: (1fr, 1.8fr, 2.4fr, 1.1fr),
    table.header([*讲次*], [*主题*], [*对应的考纲条文*], [*笔记侧直接可考*]),
    [lec-11], [通量与散度], [格林公式（法向形式）$+$ 散度概念及计算], [56%],
    [*lec-09*], [*扩展的格林定理*], [格林公式 $+$ *路径无关条件* $+$ *全微分的原函数*], [*61%*],
  )

  lec-11 命中 2 条考纲条文，lec-09 命中 3 条——而且后两条（路径无关、原函数）是考纲里少数带*“会运用”“会求”*这种动作性措辞的要求。
]

