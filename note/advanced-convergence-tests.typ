    content((1.4, 1.9), $"n 块白块"$, anchor: "south")
    content((1.4, 1.0), $ "质心" c_n = 1.4/1 = 1.4 $, anchor: "center")
    circle((1.4, 1.4), radius: 0.07, fill: red)
    content((1.4, 1.55), $ c_n $, fill: red, anchor: "south")
    // 粉色新块：中心 1.4+1=2.4 → 左端1.4，右端3.4
    rect((1.4, -0.45), (3.4, 0.15), fill: fuchsia.lighten(80%), stroke: 1.0pt + fuchsia.darken(30%))
    content((2.4, 0.3), $ "新块：中心" c_n + 1 $, anchor: "south", fill: fuchsia.darken(40%))
    circle((2.4, -0.15), radius: 0.07, fill: fuchsia.darken(40%))
    // 刻度与质心
    content((1.4, -1.0), $ c_n $, anchor: "south")
    content((2.4, -1.0), $ c_n + 1 $, anchor: "south")
    line((1.4, -0.85), (2.4, -0.85), mark: (end: "stealth"), stroke: 0.7pt + fuchsia.darken(30%))
    content((1.9, -0.72), $ 1 $, fill: fuchsia.darken(30%), anchor: "south")
    content((3.4, 0.5), $ "块长 = 2" $, anchor: "west")
  }),
