    line((0, 0), (0, 2.2), stroke: 0.8pt + black, mark: (end: "stealth"))
    content((6, 0), $n$, anchor: "west")
    content((0, 2.2), $L_n$, anchor: "south")

    let pts = ()
    for n in range(1, 7) {
      let ln = calc.pow(n * n / calc.pow(2, n), 1 / n)
      pts.push((n, ln * 2.2))
    }
    plotline(pts, stroke: 1.2pt + blue)
    for p in pts { circle(p, radius: 0.07, fill: blue) }
    line((0, 1.1), (6, 1.1), stroke: (thickness: 0.5pt, paint: red, dash: "dashed"))
    content((5.4, 1.22), text(red, size: 7pt)[$L = 1/2$], anchor: "south-east")
    content((3.0, 1.7), text(blue, size: 7pt)[$((n^2)/(2^n))^(1/n)$], anchor: "south")
  }),
